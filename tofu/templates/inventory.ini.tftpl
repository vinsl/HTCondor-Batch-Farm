# One group per role; each host is reachable through its public IP.

[central_manager]
%{ for k, v in nodes ~}
%{ if v.tags.Role == "central_manager" ~}
${k} ansible_host=${v.public_ip}
%{ endif ~}
%{ endfor ~}

[execute]
%{ for k, v in nodes ~}
%{ if v.tags.Role == "execute" ~}
${k} ansible_host=${v.public_ip}
%{ endif ~}
%{ endfor ~}

[all:vars]
ansible_user=ec2-user
ansible_ssh_private_key_file=~/.ssh/batchfarm
