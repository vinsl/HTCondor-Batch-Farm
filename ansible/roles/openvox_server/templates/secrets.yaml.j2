---
# {{ ansible_managed }}
# Hiera data holding secrets. Not part of the git repository: written here by Ansible.

# Hiera returns plain strings. lookup_options tells it to convert this value to the Sensitive type,
# which is what the class parameter expects (hidden in logs and reports).
lookup_options:
  profile::htcondor::pool_password:
    convert_to: "Sensitive"

profile::htcondor::pool_password: "{{ htcondor_pool_password }}"
