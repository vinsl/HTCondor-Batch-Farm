# Test and lint tooling for the Puppet code (the control repository in puppet/).
source 'https://rubygems.org'

gem 'openvox', '~> 8.29'          # the Puppet implementation the lab runs (puppet parser validate, epp validate)
gem 'syslog'                      # silences the Ruby 3.3 warning of the openvox gem
gem 'puppet-lint', '~> 4.2'
gem 'rspec-puppet', '~> 5.0'      # compiles catalogs and tests their content
gem 'rspec-puppet-facts', '~> 5.0'
gem 'rake'
